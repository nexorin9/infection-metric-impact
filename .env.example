# 院感指标口径影响分析 · 环境变量样例
# 只写变量名与示例格式，不含任何真实值。复制为 .env 后按院内实际情况填写。
# 令牌一律从环境变量读取，禁止硬编码、禁止写入日志。

# ---- 院内电子病历（只读：出院记录 + 字段字典） ----
EMR_BASE_URL=https://emr.example-hospital.internal
EMR_API_TOKEN=<示例格式：院内接口访问令牌>

# ---- 院感监测系统（只读：院感监测明细） ----
HAI_BASE_URL=https://hai.example-hospital.internal
HAI_API_TOKEN=<示例格式：院感监测接口访问令牌>

# ---- 院内质控系统（写：口径条目发布 + 口径包合并） ----
QC_METRICS_BASE_URL=https://qc.example-hospital.internal
QC_METRICS_TOKEN=<示例格式：质控系统写入令牌>

# ---- 区域平台（只读：上级下发口径包） ----
REGIONAL_PLATFORM_BASE_URL=https://regional.example-platform.internal
REGIONAL_TOKEN=<示例格式：区域平台下载令牌>

# ---- 模型服务（OpenAI-compatible 协议） ----
LLM_BASE_URL=https://llm.example-hospital.internal/v1
LLM_API_KEY=<示例格式：模型服务密钥>
LLM_MODEL=<示例格式：模型名称>
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
